# Production .env — serverda `cp .env.prod.example .env` qilib to'ldiring.
DJANGO_ENV=prod
DOMAIN=edu.thesofmebel.uz

# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REAL_SECRET_KEY_SHU_YERGA

ALLOWED_HOSTS=edu.thesofmebel.uz
CSRF_TRUSTED_ORIGINS=https://edu.thesofmebel.uz
# Qo'shimcha CORS manzillari (ixtiyoriy). Rasmiy frontend
# (edu-front-silk.vercel.app), *.vercel.app preview'lar va dev portlar
# kodda doim ochiq — bu yerga faqat yangi alohida domen qo'shiladi.
CORS_ALLOWED_ORIGINS=https://edu.thesofmebel.uz
TIME_ZONE=Asia/Tashkent

# Postgres
POSTGRES_DB=edtech
POSTGRES_USER=edtech
POSTGRES_PASSWORD=KUCHLI_PAROL_SHU_YERGA

# LiveKit — sekret kamida 32 belgi.
# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_API_KEY=fokus_prod
LIVEKIT_API_SECRET=KAMIDA_32_BELGILIK_SEKRET_SHU_YERGA
# Brauzer clientlari ulanadigan manzil (Caddy /livekit -> livekit:7880 proxy)
LIVEKIT_URL=wss://edu.thesofmebel.uz/livekit

# Ixtiyoriy: dars video/audio yozuvlarini bir vaqtda birlashtiradigan
# (ffmpeg) worker'lar soni (default 8). Bir nechta dars bir xil vaqtda
# tugasa ham, shu sondan ortig'i navbatda kutadi — server bir zumda
# zarba yemaydi. Yangi server olingach, real CPU/disk quvvatiga qarab
# oshirish mumkin.
# RECORDING_MERGE_WORKERS=8

# Web Push (ilova/tab yopiq bo'lganda ham bildirishnoma) — apps/notifications.
# MUHIM: bu uchtasi sozlanmasa, kod `root/settings/base.py`dagi HAMMAGA
# BIR XIL (repo tarixida ochiq) standart kalitlarga tushib qoladi — bu
# yerga albatta REAL, faqat shu serverga tegishli kalit qo'ying.
# Generatsiya: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys()"
VAPID_PUBLIC_KEY=VAPID_OCHIQ_KALIT_SHU_YERGA
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
VAPID_CLAIM_EMAIL=mailto:admin@thesofmebel.uz

# Mobil push (FCM) — apps/notifications, PUSH-BACKEND.md. Ixtiyoriy: bo'sh
# qoldirsangiz mobil push jim o'chiriladi, Web Push'ga ta'sir qilmaydi.
# 1) Firebase Console -> Project Settings -> Service accounts ->
#    Generate new private key -> JSON faylni serverga qo'ying
#    (masalan /etc/yolup/firebase-service-account.json).
# 2) docker-compose.prod.yml'dagi `backend.volumes` ostidagi izohli
#    qatorni yoqing (fayl konteyner ichida shu yo'lda ko'rinishi uchun).
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FCM_PROJECT_ID=yolup-xxxxx

# Uy vazifasini AI bilan tekshirish (ixtiyoriy) — alohida xizmat: deploy/ai-home-checker/README.md
# Bo'sh qoldirilsa uy vazifasi o'qituvchiga qo'lda baholashga tushadi.
# HOMEWORK_AI_URL=http://checker-api:8000
# HOMEWORK_AI_INTERNAL_KEY=
# HOMEWORK_AI_ORG_KEY=
