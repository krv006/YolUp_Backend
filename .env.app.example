# APP (CORE) server .env (netcup RS 2000) — serverda `cp .env.app.example .env` qilib to'ldiring.
# Eski serverdagi .env dan SECRET_KEY, VAPID_*, OPENAI_*, ESKIZ_* kabilarni KO'CHIRING (o'zgartirmang: aks holda
# foydalanuvchilar tokenlari va push obunalari yaroqsiz bo'ladi). POSTGRES_PASSWORD yangi bo'lishi mumkin.
DJANGO_ENV=prod

# Shu serverning domeni. Sinov bosqichida: edu2.thesofmebel.uz; ko'chib o'tgandan keyin: edu.thesofmebel.uz
DOMAIN=edu2.thesofmebel.uz

# Eski serverdagi qiymatni oling (python -c "import secrets; print(secrets.token_urlsafe(50))" faqat YANGI o'rnatishda)
SECRET_KEY=ESKI_SERVERDAGI_QIYMAT

ALLOWED_HOSTS=edu2.thesofmebel.uz
CSRF_TRUSTED_ORIGINS=https://edu2.thesofmebel.uz
CORS_ALLOWED_ORIGINS=https://edu2.thesofmebel.uz
TIME_ZONE=Asia/Tashkent

# Postgres
POSTGRES_DB=edtech
POSTGRES_USER=edtech
POSTGRES_PASSWORD=KUCHLI_PAROL_SHU_YERGA
# Standart qiymatlar RS 2000 (16 GB) uchun. Server RS 4000 ga o'tsa oching:
# PG_SHARED_BUFFERS=8GB
# PG_EFFECTIVE_CACHE=20GB

# Redis parol (BARCHA servislar va MEDIA server ishlatadi). Hosil qiling: python3 -c "import secrets; print(secrets.token_hex(24))"
# Faqat harf-raqam (hex) bo'lsin — URL ichida ishlatiladi.
REDIS_PASSWORD=HEX_PAROL_SHU_YERGA

# Ikki server o'rtasidagi yopiq WireGuard kanal manzillari (deploy/new/wireguard.sh shularni o'rnatadi)
CORE_WG_IP=10.10.0.1
MEDIA_WG_IP=10.10.0.2
# Yozuv so'rovlari (/api/v1/lessons/<id>/recording*) qayerga boradi: MEDIA serverdagi `rec` xizmati.
# Bitta serverli rejimda (yoki WireGuard ulanguncha) bu qatorni o'chirib qo'ying: web:8000 ishlatiladi.
REC_UPSTREAM=10.10.0.2:8000

# LiveKit — MEDIA serverdagi .env bilan AYNAN bir xil bo'lishi shart.
LIVEKIT_API_KEY=fokus_prod
LIVEKIT_API_SECRET=ESKI_SERVERDAGI_QIYMAT
# Brauzer ulanadigan manzil — MEDIA serverning domeni. (LIVEKIT_API_URL BERILMAYDI: u shundan o'zi olinadi.)
LIVEKIT_URL=wss://lk.thesofmebel.uz

# Worker'lar (RS 2000: 8 yadro). Yuk sinovidan keyin sozlanadi.
# web: WEB_WORKERS x WEB_THREADS = baza ulanishlari soni (6 x 8 = 48). ws: har worker ~32 gacha ulanish ochishi mumkin.
# MEDIA serverdagi rec (4 x 16) ham shu bazaga ulanadi — PG_MAX_CONNECTIONS hammasini qoplashi kerak.
WEB_WORKERS=6
WEB_THREADS=8
WS_WORKERS=2
PG_MAX_CONNECTIONS=250
REDIS_MAXMEMORY=2gb
# So'rov chegaralari (IP/foydalanuvchi bo'yicha). Maktab Wi-Fi'sidan ko'p o'quvchi bir vaqtda kirsa THROTTLE_AUTH ni oshiring (masalan 120/min).
# THROTTLE_AUTH=30/min
# THROTTLE_USER=240/min
# Eslatma: yozuvni MP4 ga o'tkazish (transcoder) va birlashtirish MEDIA serverda — sozlamalari .env.media.example da.

# Web Push — eski serverdagi qiymatlarni ko'chiring
VAPID_PUBLIC_KEY=ESKI_SERVERDAGI_QIYMAT
VAPID_PRIVATE_KEY="ESKI_SERVERDAGI_QIYMAT"
VAPID_CLAIM_EMAIL=mailto:admin@thesofmebel.uz

# Mobil push (FCM) — ishlatilsa: JSON faylni serverga qo'ying va docker-compose.app.yml dagi izohli qatorni yoqing
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FCM_PROJECT_ID=

# AI (OpenAI) — eski serverdagi qiymatlar
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# SMS / Email / taklif havolasi domeni — kerak bo'lganda (qarang .env.prod.example)
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# INVITE_BASE_URL=https://yolup.uz
# EMAIL_HOST=
# GEOIP_CITY_DB=

# Google / Apple bilan kirish: ruxsat etilgan client ID'lar (vergul bilan). Bo'sh bo'lsa o'sha usul 503 beradi.
# GOOGLE_CLIENT_IDS=<web>.apps.googleusercontent.com,<ios>.apps.googleusercontent.com,<android>.apps.googleusercontent.com
# APPLE_CLIENT_IDS=<Services ID (web)>,<iOS Bundle ID>
