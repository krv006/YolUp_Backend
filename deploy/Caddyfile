# Caddy — TLS (Let's Encrypt avtomatik) + reverse proxy (faqat backend API).
# Frontend alohida loyihada (boshqa hosting) — u shu domen API'sini chaqiradi.
# DOMAIN env orqali o'zgartirish mumkin (docker-compose.prod.yml).
{$DOMAIN:edu.thesofmebel.uz} {
	encode zstd gzip

	# Django — API, admin, static (whitenoise) va chat WebSocket (/ws)
	# Caddy WebSocket upgrade'ni avtomatik proxylaydi
	@backend path /api/* /admin/* /static/* /ws/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# LiveKit signaling (WebSocket). Client: wss://<domain>/livekit
	# handle_path prefiksni kesib tashlaydi: /livekit/rtc -> /rtc
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	# Uy vazifasi fayllari (o'quvchilar topshirgan daftar/rasm/audio va o'qituvchi
	# biriktirmalari) OCHIQ tarqatilmaydi — ular faqat login va ruxsat tekshiradigan
	# API orqali olinadi (/api/v1/homework/.../file/). Bu blok quyidagi umumiy
	# /media/* dan OLDIN turishi shart (birinchi mos kelgan handle ishlaydi).
	handle /media/homework/* {
		respond 404
	}

	# Media fayllar (upload) — backend bilan umumiy volume
	handle /media/* {
		root * /srv
		file_server
	}

	# Education Center CRM (education_center_crm-web-1) — CRM jamoasi o'z
	# endpointlarini shu domen ostida beradi. Caddy `education_center_crm`
	# docker tarmog'iga docker-compose.prod.yml orqali ulanadi.
	# handle_path prefiksni kesadi: /crm/api/x -> /api/x
	# DIQQAT: bu blok pastdagi umumiy `handle` (redir) dan OLDIN turishi shart.
	handle_path /crm/* {
		reverse_proxy education_center_crm-web-1:8000
	}

	# Qolgan yo'llar — API hujjatlariga yo'naltiramiz
	handle {
		redir * /api/docs/ 302
	}
}

# --- Navigo CRM (test-admin-api.navigocrm.com) ---
# Shu serverdagi boshqa loyiha — 80/443 portlar bitta (shu Caddy'da) bo'lgani
# uchun uning nginx'iga proxy qilamiz. Caddy konteyneri `navigo` docker
# tarmog'iga docker-compose.prod.yml orqali avtomatik ulanadi (external
# network) — qo'lda `docker network connect` KERAK EMAS.
test-admin-api.navigocrm.com {
	reverse_proxy nginx:80
}

# --- Eslat bot adminkasi (eslat.thesofmebel.uz) ---
# Shu serverdagi yana bir loyiha (eslat_bot_default tarmog'i) — compose'dagi
# `eslatbot` external network orqali avtomatik ulanadi.
eslat.thesofmebel.uz {
	reverse_proxy eslatbot_adminka:8000
}

# --- Smart Project (smart.thesofmebel.uz) ---
# Docker'siz loyiha (systemd + gunicorn, unix socket orqali). Ilgari host
# nginx to'g'ridan-to'g'ri 80/443 portlarni ushlagan, lekin bu Caddy
# konteyneri o'sha portlarni egallagach (edu_platform joylashtirilganda)
# host nginx o'chirilgan va marshrut unutilgan edi (502 sababi shu).
# Statik fayllar (STATIC_ROOT) ham shu yerda beriladi — loyihada whitenoise
# yo'q, ilgari buni host nginx bajargan.
smart.thesofmebel.uz {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/smart_static
		file_server
	}

	reverse_proxy unix//run/smart_project/smart_project.sock
}

# --- Ombor CRM (ombor.thesofmebel.uz) ---
# Serverda qo'lda qo'shilgan edi (gitda yo'q edi) — endi repoda. ombor-crm konteyneri
# caddy ulangan docker tarmoqlaridan birida turadi.
ombor.thesofmebel.uz {
	reverse_proxy ombor-crm:8000
}
