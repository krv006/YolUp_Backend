# MEDIA server .env (netcup RS 4000) — serverda `cp .env.media.example .env` qilib to'ldiring.
# DIQQAT: `rec` xizmati Django'ning o'zi, shuning uchun APP serverdagi .env dagi SECRET_KEY, POSTGRES_*, REDIS_PASSWORD,
# LIVEKIT_* va boshqa kalitlar bilan AYNAN BIR XIL bo'lishi shart (token imzolari va baza ulanishi shunga bog'liq).
# Eng ishonchli yo'l: APP serverdagi .env ni bu yerga ko'chirib, faqat quyidagi "MEDIA" qatorlarini qo'shing/o'zgartiring.
DJANGO_ENV=prod

# ── APP serverdagi .env dan AYNAN shu qiymatlar ──
SECRET_KEY=APP_SERVERDAGI_QIYMAT
POSTGRES_DB=edtech
POSTGRES_USER=edtech
POSTGRES_PASSWORD=APP_SERVERDAGI_QIYMAT
REDIS_PASSWORD=APP_SERVERDAGI_QIYMAT
DOMAIN=edu2.thesofmebel.uz
ALLOWED_HOSTS=edu2.thesofmebel.uz
CSRF_TRUSTED_ORIGINS=https://edu2.thesofmebel.uz
CORS_ALLOWED_ORIGINS=https://edu2.thesofmebel.uz
TIME_ZONE=Asia/Tashkent
LIVEKIT_API_KEY=fokus_prod
LIVEKIT_API_SECRET=APP_SERVERDAGI_QIYMAT
LIVEKIT_URL=wss://lk.thesofmebel.uz
# VAPID_*, OPENAI_*, ESKIZ_* kabilar bu serverda KERAK EMAS (yozuv xizmati ularni ishlatmaydi)

# ── MEDIA ga xos ──
# Shu serverning domeni (DNS A-yozuvi shu serverning IP'siga bo'lishi shart)
LK_DOMAIN=lk.thesofmebel.uz
# WireGuard manzillari (APP serverdagi .env bilan bir xil)
CORE_WG_IP=10.10.0.1
MEDIA_WG_IP=10.10.0.2

# LiveKit versiyasi (hozir eski serverda 1.13.4). Agar `manifest unknown` chiqsa — `v`siz yozing: 1.13.4
LIVEKIT_VERSION=v1.13.4

# Yadro taqsimoti (RS 4000: 12 yadro). LiveKit cheklanmaydi (eng ustuvor, ~5 yadro / 1 500 tomoshabin).
# Yozuv API'si (rec) va MP4 o'tkazuvchi (transcoder) cheklangan — dars paytida darsni sekinlashtirmasin.
REC_CPUS=3
TRANSCODER_CPUS=3
REC_WORKERS=4
REC_THREADS=16
# Yozuv serveridagi davriy vazifalar. prune_orphan_recordings (kurs o'chganda qolgan fayllarni o'chiradi) ni xohlamasangiz olib tashlang.
# prune_recordings: 7 kundan eski tayyor yozuvlarning xom qismlari va (MP4 o'qilgach) asl WebM'ini o'chiradi (disk uchun). Xohlamasangiz olib tashlang.
# watchdog: APP serverni tekshiradi va yiqilsa xabar beradi (ALERT_TELEGRAM_BOT_TOKEN + ALERT_TELEGRAM_CHAT_ID yoki ALERT_WEBHOOK_URL kerak).
# REC_JOBS=recover_recordings,prune_orphan_recordings,prune_recordings,check_disk,watchdog
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# RECORDING_MERGE_WORKERS=4
